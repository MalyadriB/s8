
UPSTOX_CLIENT_ID=your_api_key
UPSTOX_CLIENT_SECRET=your_api_secret
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback
UPSTOX_INSTRUMENT_TOKENS=NSE_EQ|INE009A01021
UPSTOX_UNDERLYING=NIFTY
UPSTOX_EXPIRY=current_week
UPSTOX_STRIKE_COUNT=5
UPSTOX_DYNAMIC_INSTRUMENTS=true
UPSTOX_RESUBSCRIBE_SECONDS=300
UPSTOX_ENABLE_STREAM=false
UPSTOX_STREAM_MODE=full
# UPSTOX_ACCESS_TOKEN=set_manually_or_leave_for_auto_login_to_fill_in
# Optional unattended token renewal (see BACKEND_GUIDE.md "Automatic token renewal").
# Off by default: enabling it means storing full account login credentials, not just
# a read-only token. Only turn this on if you understand and accept that trade-off.
# UPSTOX_AUTO_LOGIN_ENABLED=true
# UPSTOX_USERNAME=your_10_digit_mobile_number
# UPSTOX_PASSWORD=your_upstox_password
# UPSTOX_PIN_CODE=your_upstox_pin
# UPSTOX_TOTP_SECRET=totp_secret_from_upstox_2fa_setup
# UPSTOX_TOKEN_RENEWAL_TIME=03:40
COLLECTION_TIME=09:15
MARKET_SESSION_START=09:15
MARKET_SESSION_END=15:30
MARKET_HOLIDAYS=2026-10-02,2026-10-20
TIMEZONE=Asia/Kolkata
DATA_DIR=data
STREAM_DATA_DIR=data
MARKET_DATABASE=market.db
STREAM_GAP_SECONDS=5
# AWS_S3_BUCKET=your-market-data-bucket
